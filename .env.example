# Required: MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/notes-evolved

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Optional: configure both values to use shared Upstash rate limiting.
# Leave blank to use the built-in per-process in-memory limiter.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
